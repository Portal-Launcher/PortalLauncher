<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
  <id>@Launcher_AppID@</id>
  <name>Portal Launcher</name>
  <summary>Minecraft launcher with shared modpacks: one person updates, everyone else just presses Play</summary>
  <developer id="io.github.portal_launcher">
    <name>Tinsley Devers</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <description>
    <p>Portal Launcher is a Minecraft launcher built on Prism Launcher, with Modrinth's shared instances and friends list wired straight into the launcher. Share an instance with friends, and every time you change the pack they get the update before they launch. Your friends do not even need Portal: the official Modrinth App works too.</p>
    <p>Features:</p>
    <ul>
      <li>Share an instance with friends and keep everyone on the same mods automatically</li>
      <li>See which friends are online and join what they are playing</li>
      <li>Import instances from the Minecraft Launcher, CurseForge, the Modrinth App, MultiMC, GDLauncher, ATLauncher, Technic and XMCL</li>
      <li>Install mods, modpacks, resource packs and shaders from Modrinth, CurseForge and FTB</li>
      <li>Store each mod once on disk, however many instances use it</li>
      <li>Group mods, find duplicates, and roll back a mod update that went wrong</li>
      <li>Isolated instances with their own Java settings, worlds and resource packs</li>
      <li>Themes, a cat, and everything else Prism Launcher does</li>
    </ul>
  </description>
  <releases>
    <release version="@Launcher_VERSION_NAME@" date="@Launcher_BUILD_TIMESTAMP@"></release>
  </releases>
  <url type="homepage">https://portallauncher.com/</url>
  <url type="bugtracker">https://github.com/Portal-Launcher/PortalLauncher/issues</url>
  <url type="help">https://github.com/Portal-Launcher/PortalLauncher#readme</url>
  <url type="vcs-browser">https://github.com/Portal-Launcher/PortalLauncher</url>
  <url type="contribute">https://github.com/Portal-Launcher/PortalLauncher/blob/main/CONTRIBUTING.md</url>
  <content_rating type="oars-1.1">
    <content_attribute id="violence-fantasy">moderate</content_attribute>
    <content_attribute id="social-chat">intense</content_attribute>
  </content_rating>
  <launchable type="desktop-id">@Launcher_AppID@.desktop</launchable>
</component>
